<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><Version>3.1.0</Version><FileVersion>3.1.0.0</FileVersion>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>StudioDataverse</RootNamespace>
    <Title>Copilot Studio Explorer</Title><AssemblyTitle>Copilot Studio Explorer</AssemblyTitle>
    <Product>Copilot Studio Explorer</Product>
    <Authors>Ayi NEDJIMI Consultants</Authors>
    <Company>Ayi NEDJIMI Consultants</Company>
    <Copyright>© 2026 Ayi NEDJIMI Consultants</Copyright>
    <Description>Copilot Studio Explorer — exploration des agents et données Dataverse.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StudioDataverse.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);release\**;version-*\**;MapWeb\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\AgentMap\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="MapWeb\**\*.cs" />
    <None Remove="MapWeb\node_modules\**" />
    <Content Remove="release\**;version-*\**;MapWeb\node_modules\**" />
    <None Remove="release\**;version-*\**" />
    <Content Include="Assets\StudioDataverse.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\lamazero.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="lamazero.dll" />
    <Content Include="Native\LICENSE-lamazero.txt;Native\THIRD-PARTY-NOTICES.md;Native\README.md" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
  </ItemGroup>
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" Condition="Exists('$(TargetDir)App.xbf')">
        <RelativePath>App.xbf</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>


